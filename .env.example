NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
NEXT_PUBLIC_SITE_URL=
# Development: set DEMO_MODE=true and NEXT_PUBLIC_DEMO_MODE=true to use local demo storage.
# Production always disables demo mode because NODE_ENV=production.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
# Optional comma-separated production owner email allowlist.
SUPABASE_ALLOWED_OWNER_EMAILS=
# Configure your reverse proxy to overwrite this header with the client IP.
TRUSTED_CLIENT_IP_HEADER=x-vercel-forwarded-for
